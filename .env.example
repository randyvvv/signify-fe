# Base URL of signify-api. Local dev default; swap for the Railway URL once deployed.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Public site URL for canonical links, sitemap and Open Graph (default: https://www.ai-signify.com).
NEXT_PUBLIC_SITE_URL=https://www.ai-signify.com
# Google Search Console token (HTML tag method). Optional when the domain is verified via DNS.
GOOGLE_SITE_VERIFICATION=
